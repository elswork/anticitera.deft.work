	<style>
		/* ==========================================================================
		   SISTEMA DE DISEÑO DE PRECISIÓN Y ARQUITECTURA VISUAL (ANTICITERA 6 ABRIL)
		   ========================================================================== */
		@property --spot-x {
			syntax: "<percentage>";
			inherits: true;
			initial-value: 50%;
		}
		@property --spot-y {
			syntax: "<percentage>";
			inherits: true;
			initial-value: 50%;
		}
		@property --inner-size {
