		/* ==========================================================================
		   COLUMNA DERECHA DEL HERO: LENTE INTERACTIVA DE RAYOS-X DEL MECANISMO
		   ========================================================================== */
		.artifact-showcase-wrap {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}

		.artifact-frame {
			position: relative;
			border-radius: 14px;
			overflow: hidden;
			border: 1px solid var(--bronze-border-strong);
			background: #04060A;
			box-shadow:
				0 30px 65px rgba(0, 0, 0, 0.85),
				0 0 45px rgba(200, 157, 60, 0.12);
			user-select: none;
			touch-action: none;
		}

		.artifact-coords {
			position: absolute;
			top: 0.85rem;
			left: 0.85rem;
			z-index: 5;
			background: rgba(4, 6, 11, 0.86);
			border: 1px solid var(--bronze-border);
			padding: 0.35rem 0.75rem;
			border-radius: 4px;
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.7rem;
			color: var(--bronze-light);
			letter-spacing: 0.08em;
			backdrop-filter: blur(8px);
		}

		.artifact-lens-indicator {
			position: absolute;
			top: 0.85rem;
			right: 0.85rem;
			z-index: 5;
			background: rgba(16, 185, 129, 0.2);
			border: 1px solid rgba(16, 185, 129, 0.5);
			padding: 0.35rem 0.75rem;
			border-radius: 4px;
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.7rem;
			color: #A7F3D0;
			letter-spacing: 0.06em;
		}

		.artifact-layers-container {
			position: relative;
			width: 100%;
			aspect-ratio: 1 / 1;
			overflow: hidden;
			background: #04060B;
		}

		.artifact-img-base {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
		}

		.artifact-xray-reveal-layer {
			position: absolute;
			inset: 0;
			pointer-events: none;
			transition: --inner-size 0.22s ease-out, --outer-size 0.22s ease-out;
			mask-image: radial-gradient(
				circle at var(--spot-x, 50%) var(--spot-y, 50%),
				black var(--inner-size, 0px),
				transparent var(--outer-size, 0px)
			);
			-webkit-mask-image: radial-gradient(
				circle at var(--spot-x, 50%) var(--spot-y, 50%),
				black var(--inner-size, 0px),
				transparent var(--outer-size, 0px)
			);
			mask-repeat: no-repeat;
			-webkit-mask-repeat: no-repeat;
		}

		.artifact-xray-reveal-layer.is-active-full {
			mask-image: none !important;
			-webkit-mask-image: none !important;
			opacity: 1 !important;
		}

		.artifact-xray-img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			filter: saturate(1.25) contrast(1.15);
		}

		/* Retícula y mira holográfica de telemetría */
		.xray-reticle-overlay {
			position: absolute;
			inset: 0;
			pointer-events: none;
			background-image:
				radial-gradient(circle at var(--spot-x, 50%) var(--spot-y, 50%), rgba(200, 157, 60, 0.35) 0, transparent 180px),
				linear-gradient(to right, rgba(200, 157, 60, 0.05) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(200, 157, 60, 0.05) 1px, transparent 1px);
			background-size: 100% 100%, 32px 32px, 32px 32px;
			opacity: 0;
			transition: opacity 0.3s ease;
		}

		.artifact-frame:hover .xray-reticle-overlay {
			opacity: 1;
		}

		.artifact-controls-bar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			padding: 0.75rem 1rem;
			background: rgba(10, 18, 36, 0.75);
			border: 1px solid var(--bronze-border);
			border-radius: 8px;
			flex-wrap: wrap;
		}

		.btn-xray-toggle {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			background: rgba(200, 157, 60, 0.15);
			border: 1px solid var(--bronze-border-strong);
			border-radius: 6px;
			padding: 0.45rem 0.85rem;
			color: var(--bronze-light);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.2s ease;
		}

		.btn-xray-toggle:hover {
			background: var(--bronze-gold);
			color: var(--aegean-obsidian);
		}

		.artifact-scrubber-wrap {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			flex: 1;
			min-width: 140px;
		}

		.artifact-scrubber-label {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.7rem;
			color: var(--parchment-muted);
			text-transform: uppercase;
		}

		.artifact-slider {
			flex: 1;
			accent-color: var(--bronze-gold);
			cursor: pointer;
		}

		.artifact-caption {
			padding: 1.1rem 1.4rem;
			background: linear-gradient(180deg, rgba(6, 10, 18, 0.95) 0%, #04060B 100%);
			border-top: 1px solid var(--bronze-border);
		}

		.artifact-caption-title {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			color: var(--bronze-light);
			letter-spacing: 0.08em;
			margin-bottom: 0.3rem;
			font-weight: 600;
		}

		.artifact-caption-sub {
			font-size: 0.85rem;
			color: var(--parchment-muted);
			line-height: 1.5;
		}

		/* ==========================================================================
		   NUEVA SECCIÓN MACRO-VISIÓN: EL PROYECTO ANTICITERA DE UN VISTAZO (ENVERGADURA)
		   ========================================================================== */
		.macrovision-section {
			margin-bottom: 5.5rem;
		}

		.macro-header-wrap {
			text-align: center;
			max-width: 820px;
			margin: 0 auto 3rem;
		}

		.macro-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1.5rem;
		}

		@media (max-width: 1024px) {
			.macro-grid {
				grid-template-columns: repeat(2, 1fr);
			}
		}

		@media (max-width: 600px) {
			.macro-grid {
				grid-template-columns: 1fr;
			}
		}

		.macro-card {
			background: var(--surface-card);
			border: 1px solid var(--bronze-border);
			border-radius: 14px;
			padding: 2rem 1.6rem;
			position: relative;
			overflow: hidden;
			display: flex;
			flex-direction: column;
			box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
			transition: transform 0.3s var(--spring-easing), border-color 0.25s ease, box-shadow 0.3s ease;
		}

		.macro-card:hover {
			transform: translateY(-4px);
			border-color: var(--bronze-light);
			box-shadow: 0 20px 45px rgba(0, 0, 0, 0.7), 0 0 30px var(--bronze-glow);
		}

		.macro-card::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			background: linear-gradient(90deg, var(--bronze-patina), var(--bronze-light), var(--eu-blue-accent));
			opacity: 0.8;
		}

		.macro-icon {
			font-size: 1.8rem;
			margin-bottom: 1rem;
		}

		.macro-number {
			font-family: 'Cinzel', Georgia, serif;
			font-size: clamp(2rem, 3.2vw, 2.7rem);
			font-weight: 800;
			color: var(--bronze-light);
			line-height: 1.05;
			margin-bottom: 0.5rem;
			letter-spacing: -0.02em;
		}

		.macro-number-sub {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.72rem;
			letter-spacing: 0.1em;
			color: #93C5FD;
			text-transform: uppercase;
			margin-bottom: 0.85rem;
			font-weight: 600;
		}

		.macro-card-desc {
			font-size: 0.88rem;
			color: var(--parchment-muted);
			line-height: 1.6;
		}

		/* ==========================================================================
		   RELOJ ASTRONÓMICO Y CONSOLA DE HOROLOGÍA CELESTE
		   ========================================================================== */
		.horology-section {
			position: relative;
			margin: 0 auto 5.5rem;
			padding: 3.5rem 2.5rem;
			border-radius: 18px;
			background:
				radial-gradient(circle at 50% 0%, rgba(200, 157, 60, 0.16), transparent 65%),
				linear-gradient(180deg, rgba(11, 24, 52, 0.92) 0%, rgba(5, 9, 18, 0.98) 100%);
			border: 1px solid var(--bronze-border-strong);
			box-shadow:
				0 35px 80px rgba(0, 0, 0, 0.8),
				inset 0 1px 0 rgba(242, 217, 141, 0.35);
			text-align: center;
			overflow: hidden;
		}

		.horology-astrolabe-bg {
			position: absolute;
			top: 50%;
			left: 50%;
			width: 780px;
			height: 780px;
			transform: translate(-50%, -50%);
			opacity: 0.12;
			pointer-events: none;
			animation: spin-astrolabe 120s linear infinite;
		}

		@keyframes spin-astrolabe {
			from { transform: translate(-50%, -50%) rotate(0deg); }
			to { transform: translate(-50%, -50%) rotate(360deg); }
		}

		@media (prefers-reduced-motion: reduce) {
			.horology-astrolabe-bg {
				animation: none;
			}
		}

		.clock-badge {
			display: inline-block;
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.74rem;
			letter-spacing: 0.14em;
			color: var(--bronze-light);
			text-transform: uppercase;
			padding: 0.4rem 1.1rem;
			border: 1px solid var(--bronze-border);
			border-radius: 100px;
			background: rgba(4, 6, 11, 0.75);
			margin-bottom: 1.1rem;
			box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
		}

		.clock-title {
			font-family: 'Cinzel', Georgia, serif;
			font-size: clamp(1.8rem, 3.2vw, 2.7rem);
			color: var(--marble-white);
			margin-bottom: 0.95rem;
			letter-spacing: 0.02em;
		}

		.clock-desc {
			max-width: 780px;
			margin: 0 auto 2.5rem;
			color: var(--parchment-muted);
			font-size: 1.02rem;
			line-height: 1.7;
		}

		/* Engranaje interactivo SVG central */
		.interactive-gear-console {
			position: relative;
			width: 140px;
			height: 140px;
			margin: 0 auto 2rem;
		}

		.gear-svg-ring {
			position: absolute;
			inset: 0;
			transform-origin: center;
		}

		.gear-svg-ring.outer {
			animation: gear-spin-forward 40s linear infinite;
		}

		.gear-svg-ring.inner {
			animation: gear-spin-reverse 25s linear infinite;
		}

		.gear-svg-pointer {
			position: absolute;
			inset: 0;
			transform-origin: center;
			transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
		}

		@keyframes gear-spin-forward {
			from { transform: rotate(0deg); }
			to { transform: rotate(360deg); }
		}

		@keyframes gear-spin-reverse {
			from { transform: rotate(360deg); }
			to { transform: rotate(0deg); }
		}

		.countdown-grid {
			display: grid;
			grid-template-columns: repeat(4, minmax(120px, 180px));
			justify-content: center;
			gap: 1.25rem;
			margin-bottom: 2.2rem;
			position: relative;
			z-index: 2;
		}

		@media (max-width: 640px) {
			.countdown-grid {
				grid-template-columns: repeat(2, 1fr);
				gap: 0.85rem;
			}
			.horology-section {
				padding: 2.2rem 1.25rem;
			}
		}

		.countdown-cell {
			background: rgba(4, 6, 11, 0.88);
			border: 1px solid var(--bronze-border-strong);
			border-radius: 12px;
			padding: 1.4rem 0.85rem;
			position: relative;
			box-shadow: inset 0 0 30px rgba(200, 157, 60, 0.08), 0 10px 25px rgba(0, 0, 0, 0.5);
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		/* Anillo de progreso circular SVG */
		.cd-progress-circle-wrap {
			position: absolute;
			inset: 6px;
			pointer-events: none;
		}

		.cd-progress-circle-wrap svg {
			width: 100%;
			height: 100%;
			transform: rotate(-90deg);
		}

		.cd-progress-circle-bg {
			stroke: rgba(200, 157, 60, 0.12);
		}

		.cd-progress-circle-fill {
			stroke: var(--bronze-gold);
			transition: stroke-dashoffset 0.8s ease;
		}

		.countdown-number {
			font-family: 'JetBrains Mono', monospace;
			font-size: clamp(2.3rem, 4.4vw, 3.4rem);
			font-weight: 700;
			color: var(--bronze-light);
			line-height: 1.05;
			letter-spacing: -0.02em;
			margin-bottom: 0.4rem;
			position: relative;
			z-index: 2;
		}

		.countdown-unit {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.74rem;
			text-transform: uppercase;
			letter-spacing: 0.14em;
			color: var(--parchment-muted);
			position: relative;
			z-index: 2;
		}

		/* Botón interactivo de simulación Día D */
		.time-warp-control-wrap {
			margin-bottom: 1.75rem;
			position: relative;
			z-index: 2;
		}

		.btn-time-warp {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			background: rgba(200, 157, 60, 0.12);
			border: 1px solid var(--bronze-border);
			border-radius: 100px;
			padding: 0.5rem 1.15rem;
			color: var(--bronze-light);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.76rem;
			font-weight: 600;
			letter-spacing: 0.05em;
			cursor: pointer;
			transition: all 0.25s ease;
		}

		.btn-time-warp:hover {
			background: rgba(200, 157, 60, 0.28);
			border-color: var(--bronze-light);
			transform: scale(1.03);
			box-shadow: 0 0 20px rgba(200, 157, 60, 0.25);
		}

		.btn-time-warp.is-active-warp {
			background: var(--verdigris-teal);
			color: #04060B;
			border-color: #6EE7B7;
		}

		/* Zona de acción OCS mutable */
		.ocs-action-zone {
			max-width: 740px;
			margin: 0 auto;
			position: relative;
			z-index: 2;
		}

		.ocs-master-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.75rem;
			width: 100%;
			padding: 1.25rem 1.85rem;
			border-radius: 10px;
			font-family: 'Plus Jakarta Sans', sans-serif;
			font-size: 1.02rem;
			font-weight: 700;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			text-decoration: none;
			cursor: pointer;
			transition: all 0.3s var(--spring-easing);
		}

		.ocs-master-btn.is-locked {
			background: linear-gradient(135deg, rgba(0, 51, 153, 0.65) 0%, rgba(11, 27, 61, 0.9) 100%);
			border: 1.5px solid var(--bronze-light);
			color: var(--bronze-light);
			box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6);
		}

		.ocs-master-btn.is-locked:hover {
			background: linear-gradient(135deg, rgba(200, 157, 60, 0.26) 0%, rgba(0, 51, 153, 0.8) 100%);
			transform: translateY(-2px);
			box-shadow: 0 16px 40px rgba(200, 157, 60, 0.28);
		}

		.ocs-master-btn.is-unlocked {
			background: linear-gradient(135deg, #F2D98D 0%, #C89D3C 50%, #9E741B 100%);
			border: 1.5px solid #FFF5D6;
			color: #04060B;
			box-shadow: 0 0 45px rgba(242, 217, 141, 0.55);
			animation: unlocked-pulse 2s infinite ease-in-out;
		}

		@keyframes unlocked-pulse {
			0%, 100% { transform: scale(1); box-shadow: 0 0 45px rgba(242, 217, 141, 0.55); }
			50% { transform: scale(1.02); box-shadow: 0 0 65px rgba(242, 217, 141, 0.85); }
		}

		.ocs-status-note {
			margin-top: 0.95rem;
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.76rem;
			color: var(--parchment-muted);
		}

		/* ==========================================================================
		   NUEVA SECCIÓN: SIMULADOR INTERACTIVO .AI VS .IA (EL DOMAIN HACK)
		   ========================================================================== */
		.simulator-section {
			margin-bottom: 5.5rem;
		}

		.simulator-card {
			background: var(--surface-card);
			border: 1px solid var(--bronze-border);
			border-radius: 18px;
			padding: 2.8rem 2.4rem;
			position: relative;
			box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
			overflow: hidden;
		}

		.comparator-split {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
			margin-bottom: 2.5rem;
		}

		@media (max-width: 860px) {
			.comparator-split {
				grid-template-columns: 1fr;
			}
		}

		.compare-box {
			background: rgba(4, 6, 12, 0.75);
			border-radius: 12px;
			padding: 1.8rem;
			position: relative;
			border: 1px solid rgba(255, 255, 255, 0.08);
		}

		.compare-box.bad {
			border-top: 3px solid #EF4444;
		}

		.compare-box.good {
			border-top: 3px solid var(--verdigris-teal);
			background: linear-gradient(180deg, rgba(16, 185, 129, 0.08) 0%, rgba(4, 6, 12, 0.85) 100%);
			box-shadow: 0 0 30px rgba(16, 185, 129, 0.1);
		}

		.compare-badge {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.74rem;
			font-weight: 700;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			margin-bottom: 0.75rem;
			display: inline-block;
		}

		.compare-box.bad .compare-badge {
			color: #F87171;
		}

		.compare-box.good .compare-badge {
			color: #34D399;
		}

		.compare-title {
			font-family: 'Cinzel', Georgia, serif;
			font-size: 1.4rem;
			color: var(--marble-white);
			margin-bottom: 0.85rem;
		}

		.compare-list {
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 0.65rem;
			font-size: 0.9rem;
			color: var(--parchment-muted);
		}

		.compare-list li {
			display: flex;
			align-items: flex-start;
			gap: 0.55rem;
		}

		/* Consola interactiva de resolución DNS */
		.dns-tester-console {
			background: #030508;
			border: 1px solid var(--bronze-border);
			border-radius: 12px;
			padding: 1.6rem;
		}

		.dns-tester-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 1rem;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.dns-tester-title {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.82rem;
			color: var(--bronze-light);
			font-weight: 600;
			letter-spacing: 0.06em;
		}

		.dns-input-row {
			display: flex;
			gap: 0.65rem;
			margin-bottom: 1.25rem;
			flex-wrap: wrap;
		}

		.dns-input {
			flex: 1;
			min-width: 220px;
			background: rgba(10, 18, 36, 0.85);
			border: 1px solid var(--bronze-border);
			border-radius: 6px;
			padding: 0.75rem 1rem;
			color: var(--marble-white);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.9rem;
		}

		.dns-input:focus {
			outline: none;
			border-color: var(--bronze-light);
			box-shadow: 0 0 0 3px rgba(200, 157, 60, 0.2);
		}

		.btn-dns-audit {
			background: linear-gradient(135deg, var(--bronze-gold) 0%, #A87D25 100%);
			color: #04060B;
			border: none;
			border-radius: 6px;
			padding: 0.75rem 1.4rem;
			font-family: 'Plus Jakarta Sans', sans-serif;
			font-size: 0.86rem;
			font-weight: 700;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			cursor: pointer;
			transition: all 0.2s ease;
		}

		.btn-dns-audit:hover {
			background: linear-gradient(135deg, var(--bronze-light) 0%, var(--bronze-gold) 100%);
			transform: translateY(-1px);
			box-shadow: 0 6px 20px rgba(200, 157, 60, 0.35);
		}

		.dns-presets {
			display: flex;
			gap: 0.5rem;
			flex-wrap: wrap;
			margin-bottom: 1.25rem;
		}

		.dns-preset-chip {
			background: rgba(11, 27, 61, 0.5);
			border: 1px solid var(--bronze-border);
			border-radius: 100px;
			padding: 0.25rem 0.65rem;
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.74rem;
			color: var(--parchment-muted);
			cursor: pointer;
			transition: all 0.2s ease;
		}

		.dns-preset-chip:hover {
			color: var(--bronze-light);
			border-color: var(--bronze-light);
			background: rgba(200, 157, 60, 0.15);
		}

		.dns-pipeline-result {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 0.75rem;
		}

		@media (max-width: 768px) {
			.dns-pipeline-result {
				grid-template-columns: 1fr 1fr;
			}
		}

		@media (max-width: 480px) {
			.dns-pipeline-result {
				grid-template-columns: 1fr;
			}
		}

		.dns-node {
			background: rgba(10, 18, 36, 0.9);
			border: 1px solid rgba(255, 255, 255, 0.08);
			border-radius: 8px;
			padding: 0.85rem;
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			transition: border-color 0.3s ease, background 0.3s ease;
		}

		.dns-node.active {
			border-color: var(--verdigris-teal);
			background: rgba(16, 185, 129, 0.1);
		}

		.dns-node-status {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.68rem;
			color: var(--slate-muted);
			display: flex;
			align-items: center;
			gap: 0.35rem;
		}

		.dns-node.active .dns-node-status {
			color: #34D399;
		}

		.dns-node-name {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.8rem;
			font-weight: 700;
			color: var(--marble-white);
		}

		.dns-node-sub {
			font-size: 0.74rem;
			color: var(--parchment-muted);
			line-height: 1.4;
		}

		/* ==========================================================================
		   NUEVA SECCIÓN: LA ODISEA DE ANTICITERA (SCROLLYTELLING 4 ÉPOCAS)
		   ========================================================================== */
		.odyssey-section {
			margin-bottom: 5.5rem;
		}

		.odyssey-tabs-nav {
			display: flex;
			gap: 0.65rem;
			justify-content: center;
			flex-wrap: wrap;
			margin-bottom: 2.2rem;
		}

		.odyssey-tab-btn {
			background: rgba(10, 18, 36, 0.7);
			border: 1px solid var(--bronze-border);
			border-radius: 8px;
			padding: 0.65rem 1.15rem;
			color: var(--parchment-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.8rem;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.25s ease;
		}

		.odyssey-tab-btn:hover {
			color: var(--bronze-light);
			border-color: var(--bronze-light);
			background: rgba(200, 157, 60, 0.15);
