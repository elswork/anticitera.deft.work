            chip: "ΗΜΕΡΑ D · 6 ΑΠΡΙΛΙΟΥ 2027",
            title: "Στις 6 Απριλίου η Ευρώπη διεκδικεί την κυριαρχία της στην εποχή της ΤΝ",
            body: "Η Ευρωπαϊκή Επιτροπή ενέκρινε νομικά την πρωτοβουλία για το <strong>Ευρωπαϊκό Ψηφιακό Διαμέρισμα</strong> και το domain <strong>.IA</strong>. Εγγραφείτε στη Λίστα Πρωτοπόρων.",
            pill1: "🛡️ Απόφαση C(2026) 7098",
            pill2: "⏳ 1.000.000 Υπογραφές",
            pill3: "🏛️ Κυρίαρχο Domain .IA",
            cta: "Εξερευνήστε την Εκστρατεία 6 Απριλίου ↗",
            dismiss: "Υπενθύμιση αργότερα",
            targetUrl: "/6abril/?lang=el"
        }
    };

    const t = i18n[docLang] || i18n.es;
    const badgeEl = document.getElementById('popup6AbrilBadge');
    const chipEl = document.getElementById('popup6AbrilChip');
    const titleEl = document.getElementById('popup6AbrilTitle');
    const bodyEl = document.getElementById('popup6AbrilBody');
    const pill1El = document.getElementById('popup6AbrilPill1');
    const pill2El = document.getElementById('popup6AbrilPill2');
    const pill3El = document.getElementById('popup6AbrilPill3');
    const ctaEl = document.getElementById('popup6AbrilCta');
    const dismissBtn = document.getElementById('popup6AbrilDismiss');
    const closeBtn = document.getElementById('popup6AbrilCloseBtn');

    if (badgeEl) badgeEl.textContent = t.badge;
    if (chipEl) chipEl.textContent = t.chip;
    if (titleEl) titleEl.textContent = t.title;
    if (bodyEl) bodyEl.innerHTML = t.body;
    if (pill1El) pill1El.textContent = t.pill1;
    if (pill2El) pill2El.textContent = t.pill2;
    if (pill3El) pill3El.textContent = t.pill3;
    if (ctaEl) {
        ctaEl.innerHTML = `<span>${t.cta}</span>`;
        ctaEl.href = t.targetUrl;
    }
    if (dismissBtn) dismissBtn.textContent = t.dismiss;

    function dismissPopup(durationHours) {
        backdrop.classList.remove('is-visible');
        const expireTime = Date.now() + (durationHours * 60 * 60 * 1000);
        localStorage.setItem(STORAGE_KEY, String(expireTime));
        setTimeout(() => {
            backdrop.style.display = 'none';
        }, 360);
    }

    if (closeBtn) closeBtn.addEventListener('click', () => dismissPopup(24));
    if (dismissBtn) dismissBtn.addEventListener('click', () => dismissPopup(24));
    if (ctaEl) ctaEl.addEventListener('click', () => dismissPopup(72)); // 3 días si explora

    backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) dismissPopup(24);
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && backdrop.classList.contains('is-visible')) {
            dismissPopup(24);
        }
    });

    // Retardo suave de 1.4 segundos tras la carga de la página principal
    setTimeout(() => {
        backdrop.style.display = 'flex';
        void backdrop.offsetWidth; // Reflow para disparar la transición CSS
        backdrop.classList.add('is-visible');
    }, 1400);
})();
</script>
