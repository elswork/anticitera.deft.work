            pill2: "⏳ 1.000.000 de Firmas",
            pill3: "🏛️ Distrito Soberano .IA",
            cta: "Explorar Campaña 6 de Abril ↗",
            dismiss: "Recordar más tarde",
            targetUrl: "/6abril/"
        },
        en: {
            badge: "🏛️ EUROPEAN CITIZENS' INITIATIVE · ECI(2026)000012",
            chip: "D-DAY · 6 APRIL 2027",
            title: "On April 6, Europe reclaims its territory in the AI era",
            body: "The European Commission has legally validated our initiative to establish the <strong>European Digital District</strong> and the sovereign <strong>.IA</strong> domain. Explore the odyssey, ask Prometeo and join the Pioneers List.",
            pill1: "🛡️ Decision C(2026) 7098",
            pill2: "⏳ 1,000,000 Signatures",
            pill3: "🏛️ Sovereign .IA District",
            cta: "Explore April 6 Campaign ↗",
            dismiss: "Remind me later",
            targetUrl: "/6abril/?lang=en"
        },
        fr: {
            badge: "🏛️ INITIATIVE CITOYENNE EUROPÉENNE · ECI(2026)000012",
            chip: "JOUR J · 6 AVRIL 2027",
            title: "Le 6 avril, l'Europe revendique son territoire à l'ère de l'IA",
            body: "La Commission européenne a validé juridiquement notre initiative pour créer le <strong>District Numérique Européen</strong> et le domaine souverain <strong>.IA</strong>. Rejoignez la Liste des Pionniers.",
