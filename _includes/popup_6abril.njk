    const forceShow = urlParams.get('show_6abril') === '1' || urlParams.get('popup') === '1';

    const STORAGE_KEY = 'anticitera_6abril_popup_dismissed_until';
    const dismissedUntil = localStorage.getItem(STORAGE_KEY);
    if (!forceShow && dismissedUntil && Date.now() < parseInt(dismissedUntil, 10)) {
        return;
    }

    const backdrop = document.getElementById('popup6AbrilBackdrop');
