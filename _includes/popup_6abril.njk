            cta: "Découvrir la Campagne du 6 Avril ↗",
            dismiss: "Plus tard",
            targetUrl: "/6abril/?lang=fr"
        },
        it: {
            badge: "🏛️ INIZIATIVA DEI CITTADINI EUROPEI · ECI(2026)000012",
            chip: "GIORNO D · 6 APRILE 2027",
            title: "Il 6 aprile l'Europa rivendica il suo territorio nell'era dell'IA",
            body: "La Commissione Europea ha approvato l'iniziativa per la creazione del <strong>Distretto Digitale Europeo</strong> e del dominio sovrano <strong>.IA</strong>. Unisciti alla Lista dei Pionieri del Giorno 1.",
            pill1: "🛡️ Decisione C(2026) 7098",
            pill2: "⏳ 1.000.000 di Firme",
            pill3: "🏛️ Distretto Sovrano .IA",
            cta: "Esplora la Campagna del 6 Aprile ↗",
            dismiss: "Ricordamelo più tardi",
            targetUrl: "/6abril/?lang=it"
        },
        pt: {
            badge: "🏛️ INICIATIVA DE CIDADANIA EUROPEIA · ECI(2026)000012",
            chip: "DIA D · 6 DE ABRIL DE 2027",
            title: "A 6 de abril, a Europa reclama o seu território na era da IA",
            body: "A Comissão Europeia validou juridicamente a iniciativa para criar o <strong>Distrito Digital Europeu</strong> e o domínio soberano <strong>.IA</strong>. Junte-se à Lista de Pioneiros antes da abertura da urna.",
            pill1: "🛡️ Decisão C(2026) 7098",
            pill2: "⏳ 1.000.000 de Assinaturas",
            pill3: "🏛️ Distrito Soberano .IA",
            cta: "Explorar Campanha de 6 de Abril ↗",
            dismiss: "Lembrar mais tarde",
            targetUrl: "/6abril/?lang=pt"
        },
        de: {
            badge: "🏛️ EUROPÄISCHE BÜRGERINITIATIVE · ECI(2026)000012",
            chip: "TAG X · 6. APRIL 2027",
            title: "Am 6. April fordert Europa sein Territorium im KI-Zeitalter ein",
            body: "Die Europäische Kommission hat die Initiative zur Schaffung des <strong>Europäischen Digitalen Distrikts</strong> und der Domäne <strong>.IA</strong> bestätigt. Werden Sie Pionier.",
